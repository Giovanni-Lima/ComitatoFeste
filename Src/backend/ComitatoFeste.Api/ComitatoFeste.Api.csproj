<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="QuestPDF" Version="2026.8.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ComitatoFeste.Data\ComitatoFeste.Data.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Il frontend è servito come file statico dall'API (stessa origine, niente CORS in
         produzione). Sorgente unica: Src/frontend/index.html -> wwwroot/index.html sia in
         'dotnet run' sia in 'dotnet publish'. -->
    <Content Include="..\..\frontend\index.html" Link="wwwroot\index.html">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
