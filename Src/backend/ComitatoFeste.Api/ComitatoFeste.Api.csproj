<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Segreti di sviluppo (passphrase login, ecc.) fuori dal repo: caricati automaticamente
         in Development. Impostali con "dotnet user-secrets set". In produzione le env var su Render. -->
    <UserSecretsId>comitatofeste-api-dev</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="QuestPDF" Version="2026.8.0" />
    <!-- Thumbnail WebP delle immagini (ImageThumbnailer): pure-managed, nessuna dipendenza
         nativa. Restare sulla linea 3.1.x: è l'ultima sotto la "Six Labors Split License"
         (gratis per il nostro caso, come QuestPDF Community); la 4.x richiede una licenza
         a pagamento (chiave al build). 3.1.11 è senza vulnerabilità note. -->
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.11" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
    <PackageReference Include="WebPush" Version="1.0.13" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ComitatoFeste.Data\ComitatoFeste.Data.csproj" />
  </ItemGroup>

  <!-- Il frontend (wwwroot/index.html) è servito come file statico dall'API: stessa
       origine, niente CORS in produzione. Il Web SDK include wwwroot/** in build e publish. -->

</Project>
